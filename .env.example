# ───────────────────────────────────────────────────────────────────────
# Nexus Suite — environment variables
# Copy this file to `.env` and edit. See docs/SELF_HOSTING.md for full guide.
# ───────────────────────────────────────────────────────────────────────

# Database — Prisma datasource URL.
# Default (SQLite, MVP-friendly): file path on local disk.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Production (PostgreSQL) — uncomment and edit:
# DATABASE_URL="postgresql://user:password@localhost:5432/nexus?schema=public"

# ─── Auth (NextAuth.js v4) ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# REQUIRED for any non-local deployment.
NEXTAUTH_SECRET="dev-secret-change-me-in-production"

# Canonical app URL — must match your reverse proxy / domain
NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth Providers (optional) ───────────────────────────────────────
# If unset, only email/password auth is available.
# If set, "Continue with Google/GitHub" buttons appear on /signin.

# Google OAuth — get credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — get credentials at https://github.com/settings/developers
# Authorization callback URL: https://your-domain.com/api/auth/callback/github
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ─── GitHub Sync (optional) ───────────────────────────────────────────
# Org-level PAT used for outbound sync (Nexus → GitHub Issues).
# Requires `repo` scope. Per-sync PATs coming in a future release.
# GITHUB_SYNC_PAT=""

# ─── AI (optional) ────────────────────────────────────────────────────
# If unset, AI features fall back to heuristic-only mode.
# Configured via .z-ai-config file or env vars — see z-ai-web-dev-sdk docs.

# ─── Optional ──────────────────────────────────────────────────────────
# Disable auto-seed of demo org (set to 'false' in production)
# NEXUS_AUTO_SEED="true"

# Live FX rates for Module 5 (Budget) multi-currency conversion.
# If unset, falls back to static rates (fine for demo, not for real invoicing).
# Supported: OpenExchangeRates, Fixer.io, or any API returning { rates: { USD: 0.012, ... } }
# FX_API_URL="https://openexchangerates.org/api/latest.json?app_id=YOUR_ID&base=INR"
